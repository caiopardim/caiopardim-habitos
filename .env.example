# ─── Supabase ────────────────────────────────────────────────
# Painel do Supabase → Project Settings → API.
# Sem estas duas variáveis o app roda em MODO DEMONSTRAÇÃO (dados só no navegador).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Só para o script de seed (npm run seed). NUNCA exponha no frontend nem commite.
SUPABASE_SERVICE_ROLE_KEY=
# Usuário de exemplo criado pelo seed
SEED_USER_EMAIL=demo@exemplo.com
SEED_USER_PASSWORD=troque-esta-senha

# Mostra blocos "em breve" de fases futuras (só para desenvolvimento)
NEXT_PUBLIC_SHOW_ROADMAP=false

# ─── Lembretes por notificação (Web Push) ────────────────────
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável pelo envio (exigido pelo padrão Web Push)
VAPID_SUBJECT=mailto:contato@seudominio.com
# Senha do agendador que chama /api/cron/lembretes (qualquer texto longo e aleatório)
CRON_SECRET=
# O cron também usa SUPABASE_SERVICE_ROLE_KEY (definida acima) — só no servidor.

# ─── Monitoramento de erros (Sentry) — opcional ──────────────
# Sem DSN, nada é carregado. Não envia dados pessoais.
NEXT_PUBLIC_SENTRY_DSN=
# (opcional) DSN só do servidor; se vazio, usa o NEXT_PUBLIC_SENTRY_DSN
SENTRY_DSN=

# ─── Métricas de produto (PostHog) — opcional ────────────────
# Só carrega depois do consentimento da pessoa (banner). Região UE por padrão.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ─── Dados do responsável (Política de privacidade e Termos) ─
# Obrigatório preencher antes de abrir ao público.
NEXT_PUBLIC_LEGAL_RAZAO_SOCIAL=
NEXT_PUBLIC_LEGAL_DOCUMENTO=
NEXT_PUBLIC_LEGAL_ENDERECO=
NEXT_PUBLIC_LEGAL_ENCARREGADO=
NEXT_PUBLIC_LEGAL_CIDADE=
NEXT_PUBLIC_CONTATO_EMAIL=

# ─── Suporte (página /suporte) ───────────────────────────────
# WhatsApp só com dígitos, com DDI e DDD (ex.: 5511999998888)
NEXT_PUBLIC_SUPORTE_WHATSAPP=
NEXT_PUBLIC_SUPORTE_HORARIO=segunda a sexta, das 9h às 18h (horário de Brasília)

# ─── Presença ────────────────────────────────────────────────
# Endereço público do app, sem barra no fim: SEO, cartões de compartilhamento e links do pagamento
NEXT_PUBLIC_SITE_URL=https://zoryka.com.br

# ─── Planos e pagamentos (Mercado Pago) — opcional ───────────
# Desligado = app 100% grátis. Ligue só depois de configurar o Mercado Pago.
NEXT_PUBLIC_BILLING_ENABLED=false
# (NEXT_PUBLIC_SITE_URL, definida em "Presença", também é usada nos links do pagamento)
# Painel do Mercado Pago → Suas integrações → Credenciais de produção (Access Token). SÓ no servidor.
MERCADOPAGO_ACCESS_TOKEN=
# Painel → Webhooks → "Assinatura secreta". SÓ no servidor.
MERCADOPAGO_WEBHOOK_SECRET=
# O webhook também usa SUPABASE_SERVICE_ROLE_KEY para gravar a assinatura.
