# ─── Supabase ────────────────────────────────────────────────
# Painel do Supabase → Project Settings → API.
# Sem estas duas variáveis o app roda em MODO DEMONSTRAÇÃO (dados só no navegador).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Só para o script de seed (npm run seed). NUNCA exponha no frontend nem commite.
SUPABASE_SERVICE_ROLE_KEY=
# Usuário de exemplo criado pelo seed
SEED_USER_EMAIL=demo@exemplo.com
SEED_USER_PASSWORD=troque-esta-senha

# Mostra blocos "em breve" de fases futuras (só para desenvolvimento)
NEXT_PUBLIC_SHOW_ROADMAP=false

# ─── Lembretes por notificação (Web Push) ────────────────────
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável pelo envio (exigido pelo padrão Web Push)
VAPID_SUBJECT=mailto:contato@seudominio.com
# Senha do agendador que chama /api/cron/lembretes (qualquer texto longo e aleatório)
CRON_SECRET=
# O cron também usa SUPABASE_SERVICE_ROLE_KEY (definida acima) — só no servidor.

# ─── Monitoramento de erros (Sentry) — opcional ──────────────
# Sem DSN, nada é carregado. Não envia dados pessoais.
NEXT_PUBLIC_SENTRY_DSN=
# (opcional) DSN só do servidor; se vazio, usa o NEXT_PUBLIC_SENTRY_DSN
SENTRY_DSN=

# ─── Métricas de produto (PostHog) — opcional ────────────────
# Só carrega depois do consentimento da pessoa (banner). Região UE por padrão.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
