# ─── Supabase ────────────────────────────────────────────────
# Painel do Supabase → Project Settings → API.
# Sem estas duas variáveis o app roda em MODO DEMONSTRAÇÃO (dados só no navegador).
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Só para o script de seed (npm run seed). NUNCA exponha no frontend nem commite.
SUPABASE_SERVICE_ROLE_KEY=
# Usuário de exemplo criado pelo seed
SEED_USER_EMAIL=demo@exemplo.com
SEED_USER_PASSWORD=troque-esta-senha
